# eugr launch-cluster.sh config for THIS cluster — RoCE fabric, not management.
#
# WHY THIS FILE EXISTS: eugr's own .env pins LOCAL_IP=192.168.1.236, which is the
# MANAGEMENT network. Passing -n alone is not enough — launch-cluster.sh errors on
# the mismatch. Point --config at this file instead of editing eugr's .env, so an
# eugr `git pull` never silently reverts the fabric selection.
#
# 192.168.0.0/24 = RoCE fabric (enp1s0f0np0 / rocep1s0f0)  <- TP traffic belongs here
# 192.168.1.0/24 = management (SSH, image/model distribution)
CLUSTER_NODES="192.168.0.236,192.168.0.237"
LOCAL_IP="192.168.0.236"
COPY_HOSTS="192.168.0.237"
MASTER_PORT="29501"
CONTAINER_NAME="vllm_node"
