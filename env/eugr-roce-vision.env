# eugr launch-cluster.sh config for the Vision-Exp TRIAL stack — RoCE fabric.
#
# Identical to eugr-roce.env except CONTAINER_NAME and MASTER_PORT, so the trial can
# never be confused with — or accidentally stopped by — the production stack's scripts.
#
# This is NOT a co-location config. Vision-Exp cannot run alongside production:
# non-KV is ~83.4 GiB/node and production already sits at ~121.6 GiB/node. The distinct
# name exists so `docker ps` and the stop scripts are unambiguous about which stack is
# up, not because both can be.
#
# 192.168.0.0/24 = RoCE fabric (enp1s0f0np0 / rocep1s0f0)  <- TP traffic belongs here
# 192.168.1.0/24 = management (SSH, image/model distribution)
CLUSTER_NODES="192.168.0.236,192.168.0.237"
LOCAL_IP="192.168.0.236"
COPY_HOSTS="192.168.0.237"
MASTER_PORT="29502"
CONTAINER_NAME="vllm_node_vision"
